# ============================================================================
# AstroSim — environment configuration (example)
# Copy to `.env` and adjust.  NEVER commit the real .env file.
# ============================================================================

# ---------------------------------------------------------------- runtime ----
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
TRUST_PROXY=false

# ------------------------------------------------------------------ MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=astro
DB_PASSWORD=change_me_in_production
DB_NAME=astrosim
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_SSL=false
# Path to a CA certificate when DB_SSL=true
DB_SSL_CA=

# --------------------------------------------------------------- security ----
# Used to sign session/JWT tokens — must be at least 32 chars in production
JWT_SECRET=dev_only_secret_change_me_min_32_chars_long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------- limits ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=2mb
MAX_SIMULATIONS_PER_USER=50
MAX_BODIES_PER_SIMULATION=500

# --------------------------------------------------------------------- misc ---
LOG_LEVEL=info
LOG_PRETTY=true
SERVE_CLIENT=false
